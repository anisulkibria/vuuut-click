# ./run.sh generates local development credentials for you.
APP_ENV=development
# Native local databases are the default; external leaves service lifecycle to the operator.
LOCAL_DB_MODE=native
BIND=127.0.0.1:8082
PUBLIC_URL=http://localhost:8082
ALLOW_LOCALHOST=true
POSTGRES_PASSWORD=replace_with_a_random_secret
DATABASE_URL=postgres://click:replace_with_a_random_secret@127.0.0.1:55432/click
CLICKHOUSE_URL=http://127.0.0.1:58123
CLICKHOUSE_USER=click
CLICKHOUSE_PASSWORD=replace_with_another_random_secret
CLICKHOUSE_DATABASE=click
# Optional in development, required in production. Do not redistribute licensed databases.
# GEOIP_PATH=/absolute/path/GeoLite2-Country.mmdb
# TRUSTED_PROXIES=10.0.0.0/24
RUST_LOG=click_server=info,tower_http=info

# Optional payment provider. Leave unset for explicit local test billing.
# STRIPE_SECRET_KEY=sk_test_replace
# STRIPE_WEBHOOK_SECRET=whsec_replace
# STRIPE_PRICES_JSON='{"pro:monthly":"price_replace","pro:annual":"price_replace"}'
# Optional dedicated portal configuration, avoiding changes to a shared default.
# STRIPE_PORTAL_CONFIGURATION=bpc_replace
# Optional transactional mail. Without SMTP, local development writes private .local/mail/*.eml.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_FROM='Vuuut Click <analytics@example.com>'
# SMTP_USERNAME=replace
# SMTP_PASSWORD=replace

# Priority 4 real-service checks: use an inbox you control and Stripe test keys.
# Do not point automated fixture servers at real SMTP. See docs/COMMERCIAL_VALIDATION.md.
# COMMERCIAL_TEST_EMAIL=your-own-test-inbox@example.com
# Optional existing real HTTPS website UUID for the positive/negative public TXT check.
# COMMERCIAL_WEBSITE_ID=00000000-0000-0000-0000-000000000000


# Priority 5: scripts/setup-operations.py generates private local keys.
# Production requires shared budgets and random keys configured identically on replicas.
# DISTRIBUTED_LIMITS=true
# ABUSE_HASH_KEY=<64 random hexadecimal characters>
# METRICS_BEARER_TOKEN=<random 32–256 character token>
# Optional private OTLP/HTTP JSON collector; no URLs/bodies/customer identifiers are exported.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# OTEL_TRACES_SAMPLER_ARG=0.1
# Set false only on web replicas paired with a separately monitored `worker` process.
# RUN_WORKERS=true
# Encrypted off-machine backups. Password must be escrowed outside this machine/repository.
# RESTIC_REPOSITORY=s3:https://s3.example.com/private-bucket/vuuut-click
# RESTIC_PASSWORD_FILE=/private/independently-escrowed/restic-password
# AWS_ACCESS_KEY_ID=<private backup-only key>
# AWS_SECRET_ACCESS_KEY=<private backup-only secret>
# Matching-major PostgreSQL client, or the owned PG container for local validation.
# Matching native PostgreSQL clients (automatically recorded after local migration):
# LOCAL_PG_BINDIR=/opt/homebrew/opt/postgresql@17/bin
# BACKUP_PG_BINDIR=/path/to/matching/postgresql/bin
# BACKUP_PG_CONTAINER is optional only for an explicitly container-managed backup.
# BACKUP_SECRETS_FILE=/private/vuuut-click.env

# Owner console -> Connections manages provider overrides as authenticated ciphertext.
# Keep this directory/key through cache cleanup, replicas and recovery.
# CONNECTIONS_DATA_DIR=.local/connections
# CONNECTIONS_KEY=<shared 64-character hex key; otherwise a private local key is generated>
# MaxMind credentials can instead be entered in the owner console; no license is redistributed.
