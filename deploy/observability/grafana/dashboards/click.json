{
  "uid": "vuuut-click-operations",
  "title": "Vuuut Click operations",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Requests per second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "click-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(rate(click_http_requests_total[5m])) by (route,status_class)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Request p95 seconds",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "click-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95,sum(rate(click_http_request_duration_seconds_bucket[5m])) by (le,route))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Dependencies",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "click-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "click_dependency_up",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Outbox pending and dead",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "click-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "click_outbox_pending or click_outbox_dead",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Oldest accepted event seconds",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "click-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "click_outbox_oldest_pending_seconds",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "Fulfillment success age seconds",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "click-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "time()-click_fulfillment_last_success_timestamp_seconds",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "Backup success age seconds",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "click-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "time()-click_backup_last_success_timestamp_seconds",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "title": "Restore verification age seconds",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "click-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "time()-click_restore_last_success_timestamp_seconds",
          "refId": "A"
        }
      ]
    }
  ]
}
